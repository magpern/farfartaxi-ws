# Copy to `.env` and adjust. Docker Compose reads `.env` from this directory for variable substitution.
# For local `mvn spring-boot:run`, export these or use your IDE env config (Spring does not load `.env` by itself).

# --- Server ---
SERVER_PORT=8080

# Docker only: published host port for the API (container still uses 8080 internally; frontend/nginx unchanged).
# BACKEND_HOST_PORT=8081

# --- Database (no default password: generate one, e.g. `openssl rand -base64 48`) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/farfartaxi
SPRING_DATASOURCE_USERNAME=taxi_mgmt
# REQUIRED: generate with `openssl rand -base64 48` (compose fails while empty)
SPRING_DATASOURCE_PASSWORD=

# --- JWT (required, min 32 chars; the app refuses to start otherwise) ---
# Generate with: openssl rand -base64 48
# REQUIRED: generate with `openssl rand -base64 48` (compose fails while empty)
APP_JWT_SECRET=
# Default in application.properties is 525600 (365 days). Set lower if you prefer shorter sessions.
APP_JWT_EXPIRATION_MINUTES=60

# --- Bootstrap admin (password login) ---
FARFARTAXI_ADMIN_EMAIL=admin@farfartaxi.local
# Required in compose; generate with: openssl rand -base64 48 (if empty, admin bootstrap is skipped)
# REQUIRED: generate with `openssl rand -base64 48`
FARFARTAXI_ADMIN_PASSWORD=
FARFARTAXI_ADMIN_NAME=Farfar Admin

# --- Google Sign-In (Web client ID from Google Cloud Console → APIs & Services → Credentials) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional: only if you add server-side OAuth (authorization code). Not used for the current browser ID-token flow.
# GOOGLE_CLIENT_SECRET=

# --- Push (Web Push / VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://farfartaxi.pernemark.se
# Comma-separated host allowlist for push subscription endpoints (https only). Empty = allow any endpoint (tests/e2e only).
# PUSH_ENDPOINT_ALLOWLIST=fcm.googleapis.com,*.push.apple.com,updates.push.services.mozilla.com,*.push.services.mozilla.com,*.notify.windows.com,android.googleapis.com

# --- Observability (docker-compose.rpi.yml) ---
# REQUIRED: basic-auth password for /actuator/prometheus (user "prometheus"); generate with `openssl rand -base64 32`.
# If unset the endpoint denies everyone.
MANAGEMENT_PROMETHEUS_PASSWORD=
# Host address the management port 8090 is published on: the LAN address only, e.g. 192.168.1.151 (default loopback).
MANAGEMENT_BIND=

# --- Misc ---
APP_ETA_DEFAULT_KMH=35

# --- docker-compose.rpi.yml (GHCR image prefix, lowercase GitHub username or org) ---
# GHCR_OWNER=magpern
# Image tag for docker-compose.rpi.yml (required). Production pins tag + digest: sha-abc1234@sha256:<digest>
# FARFARTAXI_TAG=
# Frontend image tag for docker-compose.rpi.yml (required, no fallback). Production pins tag@sha256:digest per image.
# FARFARTAXI_FRONTEND_TAG=
